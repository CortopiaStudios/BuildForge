// Builds one Unity Build Profile with Build Forge, using the standalone Unity CLI on a Windows agent.
//
// Copy this file to the repository root, or point the job's Script Path at it.
// The agent needs Git, the Unity CLI ("unity") on the PATH of the account the
// job runs as, and an activated Unity editor of the version in
// ProjectSettings/ProjectVersion.txt with the platform modules your profiles use.
//
// Adjust PROJECT_DIR, OUTPUT_DIR, the profile names and the credential IDs below.
//
// Each Unity step first starts Unity's licensing client, the way the editor would, so
// that the editor connects to it instead of starting its own. A client the editor starts
// inherits the output "unity run" waits on, and while another process of the agent's
// account stays connected to it, the step does not return after the build. It is started
// in the same step because Jenkins ends the processes a step started when the step ends.
// See the Build Forge manual's Command line and CI page.

pipeline {
    // Any agent label expression that selects your Unity build machines.
    agent { label 'unity && windows' }

    parameters {
        // Unity Build Profile asset names in Assets/Settings/Build Profiles.
        choice(name: 'PROFILE_NAME', choices: ['Quest', 'Steam Frame', 'Windows'],
               description: 'Unity Build Profile to build')
        string(name: 'VARIANT_NAME', defaultValue: 'Default',
               description: 'Build Forge variant (Project Settings > Build Forge > Build Variants), or Default')
    }

    options {
        // Unity keeps the project open while it builds: two builds in one
        // workspace fail, and they would share the settings a build changes.
        disableConcurrentBuilds()
    }

    environment {
        // The Unity project folder for "unity run", relative to the repository
        // root: './Client' for a subfolder, '.' for a project at the root.
        PROJECT_DIR = './Client'
        // The profiles' output folder relative to the workspace (the default
        // output path is Builds/... inside the Unity project).
        OUTPUT_DIR = 'Client/Builds'
    }

    stages {
        stage('Check tools') {
            steps {
                // Shows the CLI version this agent runs; pin and check it.
                bat 'unity --version'
            }
        }

        stage('Remove previous output') {
            steps {
                // Build Forge removes what the previous build recorded, but a new
                // workspace has no record; start from an empty folder instead.
                dir("${env.OUTPUT_DIR}") {
                    deleteDir()
                }
            }
        }

        stage('Activate') {
            steps {
                // The job builds every profile of PROFILE_NAME in one workspace, across
                // platforms. Unity 6000.3.23 can fail to compile when -activeBuildProfile
                // changes platform, so switch the workspace to the profile in a run of its
                // own first (the build window's Shared workspace command). A job per
                // profile, in a workspace of its own, can leave this stage out.
                powershell '''
                    Remove-Item Env:UNITY_EDITOR_VERSION -ErrorAction SilentlyContinue
                    $version = (Get-Content "$env:PROJECT_DIR/ProjectSettings/ProjectVersion.txt" -TotalCount 1) -replace 'm_EditorVersion: ', ''
                    $client = Join-Path (unity editors path $version) 'Editor/Data/Resources/Licensing/Client/Unity.Licensing.Client.exe'
                    if (Test-Path -LiteralPath $client) {
                        Start-Process -FilePath $client -ArgumentList '--namedPipe', "Unity-LicenseClient-$env:USERNAME" -WindowStyle Hidden
                        Start-Sleep -Seconds 5
                    }
                    unity run $env:PROJECT_DIR --non-interactive -- -nographics -silent-crashes -logFile - -cacheServerWaitForUploadCompletion -executeMethod BuildForge.CommandLine.Activate -forgeBuildProfile "Assets/Settings/Build Profiles/$env:PROFILE_NAME.asset"
                    exit $LASTEXITCODE
                '''
            }
        }

        stage('Build') {
            steps {
                // Android Keystore Env reads these variable names by default. Create the
                // credentials in Jenkins (a secret file and two secret texts), or remove
                // this block for jobs that build no Android profile. Keep the key alias in
                // Player Settings, or add a string credential for ANDROID_KEY_ALIAS.
                withCredentials([
                    file(credentialsId: 'android-keystore-file', variable: 'ANDROID_KEYSTORE_PATH'),
                    string(credentialsId: 'android-keystore-password', variable: 'ANDROID_KEYSTORE_PASSWORD'),
                    string(credentialsId: 'android-key-password', variable: 'ANDROID_KEY_PASSWORD')
                ]) {
                    // Jenkins sets BUILD_NUMBER for every build; Build Number's variable
                    // sources read it. Batch mode counts as a CI build for Build Forge.
                    // Single quotes: PowerShell, not Groovy, expands the variables, so
                    // secrets never pass through Groovy string interpolation.
                    powershell '''
                        Remove-Item Env:UNITY_EDITOR_VERSION -ErrorAction SilentlyContinue
                        $version = (Get-Content "$env:PROJECT_DIR/ProjectSettings/ProjectVersion.txt" -TotalCount 1) -replace 'm_EditorVersion: ', ''
                        $client = Join-Path (unity editors path $version) 'Editor/Data/Resources/Licensing/Client/Unity.Licensing.Client.exe'
                        if (Test-Path -LiteralPath $client) {
                            Start-Process -FilePath $client -ArgumentList '--namedPipe', "Unity-LicenseClient-$env:USERNAME" -WindowStyle Hidden
                            Start-Sleep -Seconds 5
                        }
                        unity run $env:PROJECT_DIR --non-interactive -- -nographics -silent-crashes -logFile - -cacheServerWaitForUploadCompletion -executeMethod BuildForge.CommandLine.Build -activeBuildProfile "Assets/Settings/Build Profiles/$env:PROFILE_NAME.asset" -forgeVariant $env:VARIANT_NAME
                        exit $LASTEXITCODE
                    '''
                }
            }
        }
    }

    post {
        // Archive only after a successful build: a failed build can leave partial
        // output, and the Unity CLI reports a failed build as exit code 6.
        success {
            archiveArtifacts artifacts: "${env.OUTPUT_DIR}/**", fingerprint: true
        }
    }
}
